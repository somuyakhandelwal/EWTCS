# EWTCS Environment Configuration
# Emergency Ward Bed Status Monitoring & AI Daily Report System
# 
# SETUP: Copy .env.example → .env.local and update DATABASE_URL, SESSION_SECRET, NEXT_PUBLIC_APP_URL
# See DATABASE_SETUP.md for detailed setup instructions

# Database Configuration (REQUIRED)
# PostgreSQL format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:@Mylife2005@localhost:5432/ewtcs



# Security (REQUIRED)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-secret-min-32-characters-long

# Application (REQUIRED)
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
FORCE_HTTPS=true
HSTS_PRELOAD=false

# Optional: Features & Performance
RED_ALERT_THRESHOLD_MS=10800000
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_REALTIME_POLLING_INTERVAL_MS=3000
NEXT_PUBLIC_REALTIME_RETRY_INTERVAL_MS=10000
NEXT_PUBLIC_REALTIME_MAX_RETRY_INTERVAL_MS=30000

# Optional: Offline Cache (US-16)
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_KEY=ewtcs_bed_grid_cache
NEXT_PUBLIC_CACHE_VERSION=v1
NEXT_PUBLIC_CACHE_EXPIRY_MS=300000
NEXT_PUBLIC_CACHE_MAX_SIZE_BYTES=1572864

# Optional: AI Features (EPIC 9)
# Get key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here
DAILY_SUMMARY_TIMEZONE=Asia/Kolkata

# Optional: Backup Configuration (US-13.4)
BACKUP_PATH=
BACKUP_RETENTION_DAYS=30
# BACKUP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Encryption Key (REQUIRED for production)
# Format: 64-character hexadecimal (256-bit) - DO NOT commit real keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# ENVIRONMENT EXAMPLES
# LOCAL DEV:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ewtcs_dev
# SESSION_SECRET=dev-secret-at-least-32-characters-long
# NODE_ENV=development

# PRODUCTION:
# Use encrypted secrets (DATABASE_URL_ENCRYPTED) instead of plaintext
# Generate key: node scripts/encrypt-secret.js
# DATABASE_URL_ENCRYPTED=ivhex:encryptedhex
# ENCRYPTION_KEY=your-64-char-hex-key-here (store in secret management)
# SESSION_SECRET=production-secret-key-minimum-32-chars
# NODE_ENV=production

# VALIDATION
# ✅ All required variables validated on startup
# ❌ DATABASE_URL: check format, credentials, server running
# ❌ SESSION_SECRET: must be ≥32 characters
# ❌ NEXT_PUBLIC_APP_URL: must be valid URL
# 
# For full setup: See DATABASE_SETUP.md, CONFIGURATION.md
